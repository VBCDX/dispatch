{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vbcdx.dev/dispatch/sealed_secret.schema.json",
  "title": "Sealed secret",
  "description": "dispatch.sealed_secrets — the few secrets Dispatch must be able to present (outbound basic-auth passwords), envelope-encrypted with a KMS key. Referenced as dss://sec_… from a secretRef. AAD = orgId|_id|owner.",
  "type": "object",
  "required": [
    "_id",
    "orgId",
    "purpose",
    "owner",
    "envelope",
    "createdAt",
    "createdBy",
    "destroyAt"
  ],
  "properties": {
    "_id": {
      "$ref": "../shared/common.schema.json#/$defs/sealedSecretId"
    },
    "orgId": {
      "$ref": "../shared/common.schema.json#/$defs/orgId"
    },
    "purpose": {
      "enum": [
        "webhook_basic_auth"
      ]
    },
    "owner": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "const": "webhook"
        },
        "id": {
          "$ref": "../shared/common.schema.json#/$defs/webhookId"
        }
      },
      "additionalProperties": false
    },
    "envelope": {
      "$ref": "../shared/common.schema.json#/$defs/envelope"
    },
    "createdAt": {
      "$ref": "../shared/common.schema.json#/$defs/isoDate"
    },
    "createdBy": {
      "$ref": "../shared/common.schema.json#/$defs/actorRef"
    },
    "destroyAt": {
      "$ref": "../shared/common.schema.json#/$defs/isoDate",
      "description": "TTL: the webhook's expiry + 7 days, or when replaced."
    }
  },
  "additionalProperties": false
}
