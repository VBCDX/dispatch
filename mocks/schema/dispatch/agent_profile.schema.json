{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vbcdx.dev/dispatch/agent_profile.schema.json",
  "title": "Dispatch agent profile",
  "description": "dispatch.agent_profiles — Dispatch's per-app layer on suite.agents (_id = agentId): status, dsp_agent_ token, own filters, reported client. Presence (connected) is Redis only.",
  "type": "object",
  "required": [
    "_id",
    "orgId",
    "status",
    "token",
    "filters",
    "createdAt",
    "updatedAt",
    "rev"
  ],
  "properties": {
    "_id": {
      "$ref": "../shared/common.schema.json#/$defs/agentId"
    },
    "orgId": {
      "$ref": "../shared/common.schema.json#/$defs/orgId"
    },
    "status": {
      "enum": [
        "active",
        "suspended",
        "revoked"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "token": {
      "$ref": "../shared/common.schema.json#/$defs/credentialSet",
      "description": "dsp_agent_…"
    },
    "tokenDelivery": {
      "enum": [
        "shown_once",
        "sidecar"
      ]
    },
    "sidecarId": {
      "$ref": "../shared/common.schema.json#/$defs/dispatchSidecarId"
    },
    "filters": {
      "$ref": "filters.schema.json#/$defs/agentFilters"
    },
    "client": {
      "anyOf": [
        {
          "type": "object",
          "description": "What the agent reported when it connected. Informational; never used for access.",
          "required": [
            "name",
            "via"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "via": {
              "enum": [
                "MCP",
                "REST"
              ]
            },
            "at": {
              "$ref": "../shared/common.schema.json#/$defs/isoDate"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "lastTransport": {
      "type": "object",
      "required": [
        "via",
        "at"
      ],
      "properties": {
        "via": {
          "enum": [
            "MCP",
            "REST"
          ]
        },
        "at": {
          "$ref": "../shared/common.schema.json#/$defs/isoDate"
        }
      },
      "additionalProperties": false
    },
    "lastSeenAt": {
      "$ref": "../shared/common.schema.json#/$defs/nullableDate"
    },
    "configFormat": {
      "type": "string",
      "description": "Config format last downloaded on the Connect page."
    },
    "suspendedAt": {
      "$ref": "../shared/common.schema.json#/$defs/nullableDate"
    },
    "revokedAt": {
      "$ref": "../shared/common.schema.json#/$defs/nullableDate"
    },
    "createdAt": {
      "$ref": "../shared/common.schema.json#/$defs/isoDate"
    },
    "updatedAt": {
      "$ref": "../shared/common.schema.json#/$defs/isoDate"
    },
    "rev": {
      "$ref": "../shared/common.schema.json#/$defs/rev"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "_id": "ag_scraper",
      "orgId": "org_acme",
      "status": "active",
      "description": "Collects vendor status pages for incidents. Read-only by its own choice.",
      "token": {
        "current": {
          "alg": "sha256",
          "hash": "Ws1xWs1xWs1xWs1xWs1xWs1xWs1xWs1xWs1xWs1xWs1",
          "pepperVersion": 1,
          "prefix": "dsp_agent_",
          "last4": "Ws1x",
          "issuedAt": "2026-09-07T10:00:00Z",
          "expiresAt": null
        },
        "previous": null,
        "rotationCount": 0
      },
      "tokenDelivery": "shown_once",
      "filters": {
        "read": true,
        "write": false,
        "workspaceBlocklist": [],
        "agentBlocklist": []
      },
      "client": {
        "name": "REST",
        "via": "REST"
      },
      "lastSeenAt": "2026-09-27T13:59:30Z",
      "createdAt": "2026-09-07T10:00:00Z",
      "updatedAt": "2026-09-27T13:59:30Z",
      "rev": 2
    }
  ]
}
