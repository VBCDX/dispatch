# Every environment variable Dispatch reads. Copy to .env and edit; .env is
# git-ignored. Blank means "use the default shown in the comment".

# --- Server -----------------------------------------------------------------
# Address to listen on. Default :8080.
LISTEN_ADDR=
# The URL people open in the browser: scheme://host[:port], no path
# (Dispatch is served from the root). Must be https unless the host is
# localhost / 127.0.0.1 / ::1. Cookies are Secure whenever this is https.
# Default http://localhost:8080.
PUBLIC_URL=http://localhost:8080
# Log level: debug, info, warn or error. Default info.
LOG_LEVEL=
# Reverse proxies in front of Dispatch, as IP addresses or CIDR networks,
# separated by commas or spaces. Failed sign-ins are rate-limited per client
# address. Default empty: the client is the TCP peer, which is right when
# nothing sits in front of Dispatch. When the peer is a listed proxy,
# X-Forwarded-For is read from the right, skipping listed proxies, and the
# first address that is not one is the client. List only proxies you run
# and that add the address they received the request from; anything that
# can reach a listed proxy directly can set the X-Forwarded-For entries to
# its left. Never list a whole LAN or 0.0.0.0/0.
# Behind a reverse proxy in Docker, list the address or subnet the proxy
# connects from (for a proxy on the same Docker network, that network's
# subnet: `docker network inspect <network>`). With a chain of proxies, list
# each hop that appends to X-Forwarded-For. A proxy left off the list makes
# every visitor look like that proxy, so they all share one rate limit.
# Example: TRUSTED_PROXIES=172.18.0.0/16
TRUSTED_PROXIES=

# --- Storage ----------------------------------------------------------------
# Where SQLite and NATS JetStream keep their files. Default ./data
# (/data in the container image).
DATA_DIR=
# Database. Postgres:  postgres://user:password@host:5432/dispatch?sslmode=disable
#           SQLite:    sqlite://data/dispatch.db  (relative)  or  sqlite:///var/lib/dispatch/dispatch.db
# Default sqlite://$DATA_DIR/dispatch.db.
DATABASE_URL=
# JetStream file store. Default $DATA_DIR/nats.
NATS_STORE_DIR=

# --- Sign-in ----------------------------------------------------------------
# local, zitadel or both. Default local.
AUTH_MODE=local
# How long a browser session lasts. Default 24h. Minimum 1m.
SESSION_TTL=
# At least 32 characters. Encrypts the short-lived cookie that carries a
# Zitadel sign-in from the redirect to the callback. If unset, a random key
# is used per process (a sign-in in progress fails across a restart).
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Single sign-on through Zitadel or any other OpenID Connect provider.
# Optional: leave all of these blank with AUTH_MODE=local. Required when
# AUTH_MODE is zitadel or both: the issuer, client ID and client secret.
# The issuer URL, e.g. https://idp.example.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Always $PUBLIC_URL/auth/oidc/callback; register this exact URL with the provider.
# Optional: if set, it must equal that URL or Dispatch refuses to start.
OIDC_REDIRECT_URL=
# Where the provider sends the browser after sign-out. Default $PUBLIC_URL/.
# Register it with the provider as a post-logout redirect URI.
OIDC_POST_LOGOUT_REDIRECT_URL=
# Space-separated. Default "openid profile email".
OIDC_SCOPES=
# Single sign-out needs nothing more here, but with the provider, register
# $PUBLIC_URL/auth/oidc/backchannel-logout as the app's back-channel logout
# URI, so signing out of any app on the same provider session also signs this
# browser out of Dispatch.

# One-time first account, for container installs (the image has no shell
# to run `dispatch user create`). Set the email and password before the first
# `docker compose up`, or nobody can sign in to a fresh install. Created only
# when the database has no users at all; ignored afterwards. Remove the
# password once you have signed in. Minimum password length is 12.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- VBCDX suite -------------------------------------------------------------
# The app switcher in the sidebar footer: comma-separated Name=URL pairs, this
# app included (it is shown as the current one). Absolute https URLs (http
# only for localhost). Default empty, which hides the switcher. Example:
# SUITE_APPS=Dispatch=https://dispatch.example.com,Keyhole=https://keyhole.example.com
SUITE_APPS=

# --- Analytics ---------------------------------------------------------------
# Optional GA4 measurement id (G-XXXXXXXXXX) of your GA4 web data stream.
# Default empty = analytics off: the web app loads no tag, sets no cookie and
# the CSP stays strict. See docs/analytics.md for what is sent. The id is
# public: the web config endpoint serves it to the browser.
GA_MEASUREMENT_ID=

# --- Webhooks -----------------------------------------------------------------
# true = webhook deliveries may connect to private, loopback and link-local
# addresses (10.0.0.0/8, 127.0.0.1, 169.254.169.254, fd00::/8 and the like).
# Leave it off on a server reachable from outside: with it on, anyone who can
# add a webhook can make Dispatch send requests to hosts inside its network.
# The check runs on the resolved address when connecting. Default false.
# Signing secrets are stored encrypted with a key derived from
# SESSION_SECRET, or, when that is unset, a random key kept in
# $DATA_DIR/webhook.key. Changing SESSION_SECRET makes existing webhook and
# listener secrets unreadable; rotate them afterwards.
WEBHOOK_ALLOW_PRIVATE=

# --- Demo data -----------------------------------------------------------------
# true = load the demo organizations, workspaces, agents and messages into an
# empty database (one with no organizations) when the server comes up, and
# add anyone signing in for the first time to the demo org (Acme Corp) as an
# Owner. For trying Dispatch out, never for real data. `dispatch seed` loads
# the same data by hand. Default false.
SEED_DEMO_DATA=

# --- docker-compose.yml only -------------------------------------------------
# Password for the bundled Postgres. Use URL-safe characters (it is placed
# in DATABASE_URL). Required by docker compose.
POSTGRES_PASSWORD=
# Host port for Dispatch. Default 8080. docker-compose.yml binds it to
# 127.0.0.1 only: to expose Dispatch on the LAN, put it behind a reverse
# proxy on the compose network, or change the binding deliberately.
DISPATCH_PORT=

# --- Development and tests only ----------------------------------------------
# `npm run dev` in web/ proxies to this Dispatch server. Default http://localhost:8080.
DISPATCH_DEV_BACKEND=
# Run the Go tests against Postgres too (each test gets its own schema).
DISPATCH_TEST_POSTGRES_URL=
# 1 = fail instead of skipping when DISPATCH_TEST_POSTGRES_URL is unset (CI sets this).
DISPATCH_TEST_REQUIRE_POSTGRES=

# --- The example agent (`dispatch agent demo`), not the server ----------------
# The server it connects to, e.g. https://dispatch.example.com (or pass --url).
DISPATCH_URL=
# Its agent token (dsp_agent_…) and workspace token (dsp_ws_…), shown once on
# the workspace's Connect tab. Keep them out of shell history and files you share.
DISPATCH_AGENT_TOKEN=
DISPATCH_WORKSPACE_TOKEN=
